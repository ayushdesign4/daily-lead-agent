# Search Provider ('brightdata' or 'apify', default: brightdata)
SEARCH_PROVIDER=brightdata

# Bright Data SERP API Tokens (3-Account Rotation Pool)
BRIGHTDATA_API_TOKEN_1=your_brightdata_token_account_1
BRIGHTDATA_API_TOKEN_2=your_brightdata_token_account_2
BRIGHTDATA_API_TOKEN_3=your_brightdata_token_account_3

# Bright Data Zone Names (Defaults: token_1, token_22, token_333)
BRIGHTDATA_ZONE_1=token_1
BRIGHTDATA_ZONE_2=token_22
BRIGHTDATA_ZONE_3=token_333

# Apify API Token (Retained for fallback / rollback)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apify Actor ID (Default: apify/google-search-scraper)
APIFY_ACTOR_ID=apify/google-search-scraper

# Gmail SMTP Credentials (Required for sending leads and credit alerts)
GMAIL_USERNAME=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
DELIVERY_EMAIL=your_delivery_inbox@gmail.com

# Google Form URL (Sent in alert email when credits run out)
GOOGLE_FORM_URL=https://forms.gle/YOUR_FORM_LINK_HERE

# Daily target leads count (Default: 200)
DAILY_TARGET=200

# Limits
MAX_QUERIES_PER_BATCH=10
MAX_PAGES_PER_QUERY=20

# Dry run / test mode flags
DRY_RUN=false
TEST_MODE=false
