# Apify API Token (Required for production scraping)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apify Actor ID (Default: apify/google-search-scraper)
APIFY_ACTOR_ID=apify/google-search-scraper

# Gmail SMTP Credentials (Required for sending leads and credit alerts)
GMAIL_USERNAME=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
DELIVERY_EMAIL=your_delivery_inbox@gmail.com

# Google Form URL (Sent in alert email when credits run out)
GOOGLE_FORM_URL=https://forms.gle/YOUR_FORM_LINK_HERE

# Daily target leads count (Default: 200)
DAILY_TARGET=200

# Limits
MAX_QUERIES_PER_BATCH=10
MAX_PAGES_PER_QUERY=30
MAX_BATCHES_PER_RUN=5

# Dry run / test mode flags
DRY_RUN=false
TEST_MODE=false
